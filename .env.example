# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=

# Stripe (somente servidor). Price IDs mensais de cada plano.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# White-Label (opcional): sobrescreve config/tenant-brand.ts
# NEXT_PUBLIC_BRAND_NAME=
# NEXT_PUBLIC_BRAND_LOGO_URL=
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=
# NEXT_PUBLIC_BRAND_PRIMARY=#00D4FF
# NEXT_PUBLIC_BRAND_SECONDARY=#2563EB

# Cofre de credenciais (AES-256-GCM, somente servidor). Gerar:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# Agente Hermes (somente servidor)
ANTHROPIC_API_KEY=

# Telegram - bot da plataforma (somente servidor, exceto o username)
TELEGRAM_BOT_TOKEN=
# Segredo do webhook (1-256 caracteres A-Z a-z 0-9 _ -). Gerar:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Username do bot sem @ (usado no link t.me do painel)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Transcrição de áudio do Telegram (somente servidor). Padrão: OpenAI Whisper (whisper-1).
OPENAI_API_KEY=
# Opcional: se preenchida, a transcrição usa o Groq no lugar da OpenAI.
GROQ_API_KEY=

# Meta (Facebook Login for Business) - app criado em developers.facebook.com (somente servidor)
META_APP_ID=
META_APP_SECRET=

# Google (OAuth 2.0 Web application) - Google Cloud Console > APIs e serviços > Credenciais (somente servidor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places API (New), somente servidor; integração de extração ainda não ativada.
GOOGLE_PLACES_API_KEY=

# Gateway B2B autorizado (contrato normalizado, somente servidor).
B2B_PROSPECTING_API_URL=
B2B_PROSPECTING_API_KEY=

# Super-Admin da plataforma (somente servidor; e-mails separados por vírgula).
SUPER_ADMIN_EMAILS=

# Asaas — assinaturas recorrentes via Pix e Boleto (somente servidor).
# ASAAS_ENV: sandbox (padrão) ou production
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
# White-Label build-time configuration (optional; rebuild the image after changes).
# NEXT_PUBLIC_BRAND_FAVICON_URL=https://example.com/favicon.ico
# NEXT_PUBLIC_BRAND_SUPPORT_WHATSAPP=5511999999999
