# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# env files — nunca versionar segredos (exceto o modelo sem valores)
.env*
!.env.example

# chaves privadas e credenciais
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
id_rsa*
id_ed25519*
service-account*.json
*credentials*.json
*.secret

# supabase local
supabase/.temp/
supabase/.branches/
supabase/.env*

# skills instaladas (restaurar com: npx skills experimental_install)
/.agents/
/.claude/skills/

# misc
.DS_Store
Thumbs.db
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
